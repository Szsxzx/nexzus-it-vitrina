# === Backend (FastAPI) — NEXZUS IT SERVICE ===
APP_NAME=NEXZUS IT SERVICE API
ENV=development
DEBUG=true

# Base de datos — SQLite por default (cero instalación).
# Para Postgres descomenta la siguiente línea y comenta la de SQLite.
DATABASE_URL=sqlite:///./nexzus.db
# DATABASE_URL=postgresql+psycopg2://vitrina:vitrina@localhost:5434/vitrina

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — orígenes del frontend separados por coma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primer admin (se crea en el seed)
FIRST_ADMIN_EMAIL=admin@nexzusit.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin123!

# URL pública del frontend (Wompi redirige a {PUBLIC_SITE_URL}/checkout/resultado)
PUBLIC_SITE_URL=http://localhost:3000

# === Pagos Wompi ===
# Llaves en https://comercios.wompi.co → Desarrolladores. Usa las de "Pruebas"
# (pub_test_..., prv_test_..., test_integrity_..., test_events_...) con WOMPI_ENV=sandbox.
# Sin WOMPI_PUBLIC_KEY + WOMPI_INTEGRITY_SECRET, POST /payments/checkout responde 503.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
