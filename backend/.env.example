# === Backend (FastAPI) ===
APP_NAME=INCODOL API
ENV=development
DEBUG=true

# Base de datos — SQLite por default (cero instalación).
# Para Postgres descomenta la siguiente línea y comenta la de SQLite.
DATABASE_URL=sqlite:///./incodol.db
# DATABASE_URL=postgresql+psycopg2://incodol:incodol@localhost:5432/incodol

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — orígenes del frontend separados por coma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primer admin (se crea en el seed)
FIRST_ADMIN_EMAIL=admin@fuentedevida.co
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin123!
